# Database Configuration
# Local MongoDB on EC2 Ubuntu:
MONGO_URI=mongodb://127.0.0.1:27017/lg-ecommerce
# Remote Atlas MongoDB (alternative):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/lg-ecommerce

JWT_SECRET=replace_with_a_secure_random_jwt_secret
PORT=5000

SUPERADMIN_EMAIL=admin@svrmart.com
SUPERADMIN_PASSWORD=admin123

# Google OAuth Configuration (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# AWS S3 Configuration
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=my-ecommerce-s3-bucket
# If using IAM Role on EC2, you can leave these two blank:
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# SMTP Mail Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="SVR Mart <support@svrmart.com>"

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
